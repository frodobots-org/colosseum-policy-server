host: 127.0.0.1
port: 8000
backend:
  name: example
  options: {}
log_dir: local-policy-logs
start_timeout_seconds: 180
models:
  - name: example-model
    url: https://huggingface.co/example/model
    revision: "0000000000000000000000000000000000000000"
    subfolder: ""
    action_space: joint_position
    action_dim: 8
    control_hz: 15
    max_horizon: 1
    endpoint: ws://127.0.0.1:9100
    launcher: []
    backend_options: {}
